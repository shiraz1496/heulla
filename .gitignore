# =============================================================================
# Secrets / environment
# =============================================================================
.env

# =============================================================================
# WordPress core is provided by the Docker image — never committed.
# Only wp-content is bind-mounted; we selectively track our own code.
# =============================================================================

# Uploads / generated content
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-content/wp-cache-config.php

# Plugins: ignore everything, then allow our own custom plugins explicitly.
/wp-content/plugins/*
!/wp-content/plugins/.gitkeep
# To track a custom plugin, add an exception, e.g.:
# !/wp-content/plugins/highwater-core/

# Themes: ignore everything, then allow our working theme.
/wp-content/themes/*
!/wp-content/themes/working-theme/

# Must-use plugins: keep the dir, allow tracked drop-ins.
/wp-content/mu-plugins/*
!/wp-content/mu-plugins/.gitkeep

# =============================================================================
# Theme build artifacts & dependencies (regenerated by setup.sh / deploy.sh)
# =============================================================================
wp-content/themes/working-theme/node_modules/
wp-content/themes/working-theme/vendor/
wp-content/themes/working-theme/public/build/
wp-content/themes/working-theme/public/hot
wp-content/themes/working-theme/storage/framework/cache/
wp-content/themes/working-theme/storage/framework/views/
wp-content/themes/working-theme/storage/framework/sessions/
wp-content/themes/working-theme/dist/

# =============================================================================
# OS / editor cruft
# =============================================================================
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.sublime-*
