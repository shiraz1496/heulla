# =============================================================================
# Project environment — copy to .env (setup.sh does this automatically).
# .env holds real secrets and is git-ignored. NEVER commit .env.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Public URL of the site. Local default below; on the VPS set your real domain.
WP_HOME=http://localhost:8080
# Host port the WordPress container is published on (maps to container :80).
WP_HTTP_PORT=8080

# --- WordPress admin (used only on first install by setup.sh) ------------------
WP_TITLE=OBS WordPress
WP_ADMIN_USER=admin
# Leave blank to have setup.sh generate a strong random password and print it.
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=oshiraz@wearehighwater.com

# --- Database -----------------------------------------------------------------
DB_NAME=wordpress
DB_USER=wordpress
# Leave blank to have setup.sh generate a strong random password.
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_HOST=db:3306
# Table prefix.
DB_PREFIX=wp_

# --- phpMyAdmin ---------------------------------------------------------------
PMA_HTTP_PORT=8081

# --- Vite dev server (Sage HMR) -----------------------------------------------
VITE_PORT=5173

# --- WordPress salts ----------------------------------------------------------
# setup.sh fills these from https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# --- Environment --------------------------------------------------------------
# 'development' enables WP_DEBUG; 'production' disables it.
WP_ENV=development
